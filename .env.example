# Server-side only. Never expose credentials through NEXT_PUBLIC_*.
MODEL_API_KEY=
MODEL_API_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3
AGENT_MODE=fixture
# Use meta for official Muse Responses API; llm for another explicitly configured OpenAI-compatible provider.
# MODEL_API_PROTOCOL=chat_completions
# Set false to disable the deliberate first-attempt failure in the fixture.
FIXTURE_RECOVERY=true
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
WEB_PORT=7258
FIXTURE_PORT=3100
TRUSTPATCH_DATABASE=.data/trustpatch.db
TRUSTPATCH_ARTIFACTS=artifacts
TRUSTPATCH_FIXTURE_URL=http://127.0.0.1:3100
TRUSTPATCH_FIXTURE_PATH=fixtures/broken-next-site
# Optional REA enrichment. Both endpoints are server-side only; leave blank for built-in reactive diagnostics.
# REA_MCP_URL=http://127.0.0.1:3000/mcp
# REA_CDP_URL=http://127.0.0.1:9222
# Open the approved target in the configured CDP browser before running REA enrichment.
# Optional CVE MCP provider from https://github.com/mukul975/cve-mcp-server. OSV.dev dependency evidence remains available without it.
# Run the server with MCP_TRANSPORT=http, HOST=127.0.0.1, PORT=8000. Optional NVD/GitHub keys belong only in its server-side environment.
# CVE_MCP_URL=http://127.0.0.1:8000/mcp
# Optional JEBAT MCP read-only research, SEO, advisor, and passive security tools. Never expose unrestricted shell/filesystem tools to public users.
# JEBAT_MCP_URL=http://127.0.0.1:18789/message
# JEBAT_MCP_API_KEY=
# Optional real email delivery through Resend. Without it, Email RCA produces a local .eml preview with the PDF attached and sends nothing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=TrustPatch <reports@resend.dev>
